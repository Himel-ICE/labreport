---USING WHERE CLAUSE---
SELECT ID, NAME, SALARY FROM CUSTOMERS
WHERE SALARY > 2000

--- WHERE CLAUSE WITH UPDATE STATEMENT---
UPDATE CUSTOMERS SET SALARY = SALARY + 1000
WHERE NAME = 'Ramesh'

--- WHERE CLUSE WITH IN KEY WORD ---
SELECT * FROM CUSTOMERS
WHERE ADDRESS IN ('Bhopal', 'Ahmedabad')

---WHERE CLAUSE WITH NOT IN STAEMENT---
SELECT * FROM CUSTOMERS
WHERE AGE NOT IN(25, 23,22)

---WHERE CLAUSE WITH LIKE STATEMENT---
SELECT * FROM CUSTOMERS
WHERE NAME LIKE 'H____%'

---WHERE CLAUSE WITH AND / OR OPERATOR ---
SELECT * FROM CUSTOMERS
WHERE(AGE < 25 OR NAME ='Ramesh') AND SALARY > 2000

--- TOP CLUSE ---
SELECT TOP 3 * FROM CUSTOMERS 

--- TOP CLAUSE WITH ORDER BY ---
SELECT TOP 3 * FROM CUSTOMERS ORDER BY SALARY DESC

--- ORDER BY CLAUSE ---

SELECT TOP 3 * FROM CUSTOMERS ORDER BY SALARY ASC
SELECT * FROM CUSTOMERS ORDER BY SALARY DESC

--TO PRINT THE 2ND LARGEST VALUE OF A TABLE--
SELECT TOP 1 * FROM
(
	SELECT DISTINCT TOP 2 * FROM CUSTOMERS
	ORDER BY SALARY DESC
) AS TEMP
ORDER BY SALARY ASC

--- GROUP BY CLAUSE ---
SELECT AGE, COUNT(NAME) FROM CUSTOMERS GROUP BY AGE

SELECT AGE, MAX(SALARY) AS MAX_SALARY
FROM CUSTOMERS GROUP BY AGE

SELECT ADDRESS, AVG(SALARY) AS AVG_SALARY
FROM CUSTOMERS GROUP BY ADDRESS

SELECT AGE, MIN(SALARY) AS MIN_SALARY 
FROM CUSTOMERS
GROUP BY AGE ORDER BY MIN_SALARY DESC

SELECT ADDRESS, AGE, MIN(SALARY) AS MIN_SALARY
FROM CUSTOMERS
GROUP BY ADDRESS, AGE HAVING AGE > 24

SELECT ADDRESS, AGE, SUM(SALARY) AS TOTAL_SALARY 
FROM CUSTOMERS 
GROUP BY ADDRESS, AGE HAVING SUM(SALARY) >=5000 
ORDER BY SUM(SALARY) DESC;

SELECT ADDRESS,MAX(SALARY) AS MAX_SALARY
FROM CUSTOMERS
GROUP BY ADDRESS, SALARY HAVING MAX(SALARY) > 5000

CREATE TABLE ORDERS
(
	OID INT PRIMARY KEY NOT NULL,
	DATE VARCHAR(20),
	CUSTOMER_ID INT NOT NULL,
	AMOUNT DECIMAL(18, 2)
)

