(103, 'VIVEK', 3426);

SELECT * FROM EMPLOYEE

--- INNER JOIN ---
SELECT OID, DATE, AMOUNT, EMPLOYEE_NAME 
FROM CUSTOMERS
INNER JOIN ORDERS ON CUSTOMERS.ID = ORDERS.CUSTOMER_ID
INNER JOIN EMPLOYEE ON ORDERS.OID = EMPLOYEE.EID

--- INNER JOIN WITH WHERE CLAUSE ---
SELECT ID, NAME, DATE, AMOUNT FROM CUSTOMERS
INNER JOIN ORDERS ON CUSTOMERS.ID = ORDERS.CUSTOMER_ID
WHERE ORDERS.AMOUNT > 2500

--- LEFT JOIN ---
SELECT CUSTOMERS.ID, CUSTOMERS.NAME, ORDERS.DATE, EMPLOYEE.EMPLOYEE_NAME
FROM CUSTOMERS
LEFT JOIN ORDERS ON CUSTOMERS.ID = ORDERS.CUSTOMER_ID
LEFT JOIN EMPLOYEE ON ORDERS.OID = EMPLOYEE.EID


--- LEFT JOIN WITH WHERE CLAUSE ---
SELECT CUSTOMERS.NAME, ORDERS.AMOUNT, EMPLOYEE.EMPLOYEE_NAME, ORDERS.AMOUNT
FROM CUSTOMERS
LEFT JOIN ORDERS ON CUSTOMERS.ID = ORDERS.CUSTOMER_ID
LEFT JOIN EMPLOYEE ON ORDERS.OID = EMPLOYEE.EID
WHERE ORDERS.AMOUNT > 2000


--- TRIGGER ---
ALTER TABLE EMPLOYEE
ADD YEARLY_SALARY DECIMAL(20, 2)

SELECT * FROM EMPLOYEE

UPDATE EMPLOYEE
SET YEARLY_SALARY = SALES_MADE * 12



CREATE TRIGGER trg_UpdateYearlySalary
ON EMPLOYEE
AFTER UPDATEs
AS
BEGIN
    UPDATE EMPLOYEE
    SET YEARLY_SALARY = i.SALES_MADE * 12
    FROM inserted i
    WHERE EMPLOYEE.EID = i.EID;
END;
